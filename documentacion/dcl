// BOTON.java - Clase abstracta para botones del sistema

///
  //Clase base para todos los botones del sistema.
 // usé abstracción aquí porque todos los botones comparten funcionalidad básica: tener un piso y poder iluminarse.
 
public abstract class Boton {
    protected int piso;           // El piso asociado a este botón
    protected boolean iluminado = false;  // Si está encendido o no

     // Constructor - inicializa el botón con un piso específico
     // @param piso El número de piso que representa este botón
     //
    public Boton(int piso) {
        this.piso = piso;
    }

    // Getters básicos
    public int getPiso() { return piso; }
    public boolean isIluminado() { return iluminado; }

    /////
     // Enciende la luz del botón - se llama cuando alguien lo presiona
     ///
    public void encender() { 
        iluminado = true; 
        System.out.println("Botón del piso " + piso + " se encendió");
    }

    //
     // Apaga la luz del botón - se llama cuando el ascensor llega
    /
    public void apagar() { 
        iluminado = false; 
        System.out.println("Botón del piso " + piso + " se apagó");
    }
}


// ELEVADOR.java - Clase que representa un ascensor individual

/////
 // Representa un ascensor con su estado actual y comportamiento.
 // Esta clase me costó mucho porque tuve que pensar en todos los estados
 // posibles de un ascensor y cómo transicionar entre ellos.
 ///
public class Elevador {
    /////
     // Direcciones posibles del ascensor.
     // Usé enum porque es más seguro que strings y más claro que números.
     ///
    public enum Direccion {SUBIENDO, BAJANDO, DETENIDO}

    private final int id;                 // Identificador único
    private int pisoActual;               // Piso donde está actualmente
    private Direccion direccion = Direccion.DETENIDO;  // Dirección actual
    private Direccion ultimaDireccion = Direccion.DETENIDO; // Para recordar el último movimiento
    private final Puerta puerta = new Puerta();  // La puerta del ascensor

    /////
     // Constructor - crea un nuevo ascensor
     // @param id Número identificador
     // @param pisoInicial Piso donde empieza (generalmente 1)
     ///
    public Elevador(int id, int pisoInicial) {
        this.id = id;
        this.pisoActual = pisoInicial;
        System.out.println("Ascensor " + id + " creado en piso " + pisoInicial);
    }

    // Getters para que el control pueda tomar decisiones
    public int getId() { return id; }
    public int getPisoActual() { return pisoActual; }
    public Direccion getDireccion() { return direccion; }
    public Direccion getUltimaDireccion() { return ultimaDireccion; }

    // Métodos para controlar la puerta
    public void abrirPuerta() { puerta.abrir(); }
    public void cerrarPuerta() { puerta.cerrar(); }

    /////
     // Mueve el ascensor a un piso destino mostrando el progreso
     // @param destino Piso al que debe llegar el ascensor
     // 
     // Esta función fue difícil porque tuve que simular el movimiento
     // piso por piso en lugar de teleportarse directamente.
     ///
    public void moverHasta(int destino) {
        // Si ya está en el destino, solo abrir y cerrar puertas
        if (destino == pisoActual) {
            System.out.println("Ascensor " + id + ": ya está en el piso " + pisoActual);
            abrirPuerta();
            cerrarPuerta();
            return;
        }

        // Determinar dirección del movimiento
        if (destino > pisoActual) {
            direccion = Direccion.SUBIENDO;
            System.out.println("Ascensor " + id + ": comenzando a SUBIR desde piso " + pisoActual);
        } else {
            direccion = Direccion.BAJANDO;
            System.out.println("Ascensor " + id + ": comenzando a BAJAR desde piso " + pisoActual);
        }

        // Guardar esta dirección para decisiones futuras
        ultimaDireccion = direccion;

        // Movimiento piso por piso (simulación realista)
        while (pisoActual != destino) {
            if (direccion == Direccion.SUBIENDO) {
                pisoActual++;
                System.out.println("Ascensor " + id + ": subiendo al piso " + pisoActual + "...");
            } else {
                pisoActual--;
                System.out.println("Ascensor " + id + ": bajando al piso " + pisoActual + "...");
            }
            
            // Pequeña pausa para hacerlo más real
            try { Thread.sleep(500); } catch (InterruptedException e) {}
        }

        // Llegó al destino
        direccion = Direccion.DETENIDO;
        System.out.println("Ascensor " + id + ": ¡Llegó al piso " + pisoActual + "!");
        abrirPuerta();
        cerrarPuerta();
    }
}

